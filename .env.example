# Postgres (Neon / Supabase / Vercel Postgres)
# DATABASE_URL: conexion POOLED (host con -pooler). La usa la app en runtime.
# DIRECT_URL: conexion DIRECTA (sin -pooler). La usan prisma db push / migrate.
# En Vercel basta con DATABASE_URL; DIRECT_URL solo hace falta donde corras
# "prisma db push" / "prisma migrate" (normalmente tu maquina).
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Firma de las sesiones de staff/admin. Cadena aleatoria de 32+ caracteres.
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL publica de la app (se usa dentro de los codigos QR)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PIN del administrador creado por el seed
ADMIN_PIN="482913"

# Resend (correo transaccional): codigo de verificacion y pase con QR.
# El dominio fester.com.mx ya esta verificado en Resend; la API key se crea en
# https://resend.com/api-keys. Sin RESEND_API_KEY no se puede completar el
# registro en produccion (en local el correo se imprime en la terminal).
RESEND_API_KEY=""
# Remitente verificado. Formato "Nombre <correo@dominio>".
RESEND_FROM="Encuentro Fester <encuentro@fester.com.mx>"
# A donde llegan las respuestas de los asistentes. Si se deja vacia se usa
# NEXT_PUBLIC_SUPPORT_EMAIL (y, si tampoco existe, el correo del evento).
RESEND_REPLY_TO=""

# Buzon de soporte del Encuentro, aparte del correo institucional
# encuentro@fester.com.mx (que es el remitente y el contacto general).
# Mientras este vacia, la ayuda y las respuestas caen en el correo del evento y
# el pie no anuncia un buzon de soporte que todavia no existe.
NEXT_PUBLIC_SUPPORT_EMAIL=""
