# Postgres (Neon / Supabase / Vercel Postgres)
# DATABASE_URL: conexion POOLED (host con -pooler). La usa la app en runtime.
# DIRECT_URL: conexion DIRECTA (sin -pooler). La usan prisma db push / migrate.
# En Vercel basta con DATABASE_URL; DIRECT_URL solo hace falta donde corras
# "prisma db push" / "prisma migrate" (normalmente tu maquina).
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Firma de las sesiones de staff/admin. Cadena aleatoria de 32+ caracteres.
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL publica de la app (se usa dentro de los codigos QR)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PIN del administrador creado por el seed
ADMIN_PIN="482913"
