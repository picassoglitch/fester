# Postgres (Neon / Supabase / Vercel Postgres)
# DATABASE_URL: conexion POOLED (host con -pooler). La usa la app en runtime.
# DIRECT_URL: conexion DIRECTA (sin -pooler). La usan prisma db push / migrate.
# En Vercel basta con DATABASE_URL; DIRECT_URL solo hace falta donde corras
# "prisma db push" / "prisma migrate" (normalmente tu maquina).
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Firma de las sesiones de staff/admin. Cadena aleatoria de 32+ caracteres.
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL publica de la app (se usa dentro de los codigos QR)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PIN del administrador creado por el seed.
# Obligatorio para el seed: 8 dígitos, único por entorno. Nunca lo subas al repo.
ADMIN_PIN=""

# Resend (correo transaccional): codigo de verificacion y pase con QR.
# El dominio verificado en Resend es encuentrofester.com.mx; la API key se crea
# en https://resend.com/api-keys. Sin RESEND_API_KEY no se puede completar el
# registro en produccion (en local el correo se imprime en la terminal).
RESEND_API_KEY=""
# Remitente. Solo hace falta para cambiar el valor por defecto
# "Encuentro Fester <no-reply@encuentrofester.com.mx>". OJO: tiene que ser del
# dominio verificado en Resend o la API responde 403 y no sale ningun correo.
RESEND_FROM=""
# A donde llegan las respuestas de los asistentes. Si se deja vacia se usa
# NEXT_PUBLIC_SUPPORT_EMAIL (y, si tampoco existe, contacto@encuentrofester.com.mx).
RESEND_REPLY_TO=""

# Correo de contacto y soporte del Encuentro. Si se deja vacia se usa
# contacto@encuentrofester.com.mx, que es el que aparece en el pie, los correos,
# las preguntas frecuentes y /mi-cuenta. Solo llenala para cambiar ese buzon.
NEXT_PUBLIC_SUPPORT_EMAIL=""
