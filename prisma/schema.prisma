generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// STAFF registra estaciones ("Escaneo"); PRIZES solo entrega premios
/// ("Premios"); ADMIN puede todo.
enum Role {
  STAFF
  PRIZES
  ADMIN
}

/// Para que se sepa si el codigo de 6 digitos es de un registro nuevo o de
/// alguien que vuelve a abrir su pase.
/// De donde salio el pase: el formulario web o el registro en la puerta el dia del evento.
enum AttendeeOrigin {
  WEB
  PUERTA
}

enum VerificationPurpose {
  REGISTER
  LOGIN
}

model Staff {
  id             String   @id @default(cuid())
  name           String
  pinHash        String
  role           Role     @default(STAFF)
  active         Boolean  @default(true)
  /// Va en el JWT como "sv". Subirlo invalida las sesiones abiertas.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())

  scans    Scan[]
  redeemed Attendee[] @relation("RedeemedBy")
  accesses Access[]
}

model Station {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("⭐")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  scans Scan[]

  @@index([order])
}

model Attendee {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  email           String?
  phone           String?
  company         String?
  position        String?
  industry        String?
  state           String?
  /// Ciudad capturada por la version anterior del formulario; hoy se pide estado.
  city            String?
  age             Int?
  referral        String?
  privacyAt       DateTime?
  /// Momento en que la persona confirmo el codigo enviado a su correo.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  redeemedAt      DateTime?

  redeemedById String?
  redeemedBy   Staff?  @relation("RedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)

  /// Aprobado por Fester ("Sí" en REGISTROS): solo filtra la rifa, no la entrada.
  approved Boolean   @default(false)
  /// Dentro del foro desde este momento; null = afuera. Lo mueven los QR de entrada y salida.
  insideAt DateTime?
  /// Perfil de la base de Fester (columna «Perfil» de REGISTROS); define el color del brazalete.
  festerProfile String?
  /// Aldo 2026-11-05 — quien se registra en la puerta (PUERTA) no entra a la rifa.
  origin AttendeeOrigin @default(WEB)

  scans      Scan[]
  accesses   Access[]
  raffleWins RaffleWinner[]

  @@index([createdAt])
  @@index([completedAt])
  @@index([insideAt])
}

model Scan {
  id         String   @id @default(cuid())
  attendeeId String
  stationId  String
  staffId    String?
  createdAt  DateTime @default(now())

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  station  Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([attendeeId, stationId])
  @@index([createdAt])
  @@index([stationId])
}

/// Codigo de 6 digitos que se envia por correo antes de crear un pase
/// (REGISTER) o de abrir la cuenta de quien ya se registro (LOGIN).
/// Solo se guarda el HMAC del codigo, nunca el codigo en claro.
model EmailVerification {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose @default(REGISTER)
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// Contadores de intentos (login con PIN, envio de codigos, correo de prueba).
/// La llave lleva el HMAC de la IP o el id del staff, nunca la IP en claro.
model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  lockLevel   Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

enum AccessKind {
  ENTRY
  EXIT
}

/// Bitacora de la puerta del foro: cada QR leido en Entrada o Salida.
model Access {
  id         String     @id @default(cuid())
  attendeeId String
  kind       AccessKind
  staffId    String?
  /// Entro con "Dejar pasar": aforo lleno.
  override   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([attendeeId])
}

/// Ganadores de la rifa. Unico por asistente: nadie gana dos veces, ni quien se anulo por no estar.
model RaffleWinner {
  id         String    @id @default(cuid())
  attendeeId String    @unique
  createdAt  DateTime  @default(now())
  /// Se anulo (no estaba en el foro); se vuelve a sortear.
  voidedAt   DateTime?

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
