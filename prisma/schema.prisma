generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STAFF
  ADMIN
}

/// Para que se sepa si el codigo de 6 digitos es de un registro nuevo o de
/// alguien que vuelve a abrir su pase.
enum VerificationPurpose {
  REGISTER
  LOGIN
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  role      Role     @default(STAFF)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  scans     Scan[]
  redeemed  Attendee[] @relation("RedeemedBy")
}

model Station {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("⭐")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  scans     Scan[]

  @@index([order])
}

model Attendee {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  email       String?
  phone       String?
  company     String?
  position    String?
  industry    String?
  state       String?
  /// Ciudad capturada por la version anterior del formulario; hoy se pide estado.
  city        String?
  age         Int?
  referral    String?
  privacyAt   DateTime?
  /// Momento en que la persona confirmo el codigo enviado a su correo.
  emailVerifiedAt DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  redeemedAt  DateTime?

  redeemedById String?
  redeemedBy   Staff?  @relation("RedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)

  scans       Scan[]

  @@index([createdAt])
  @@index([completedAt])
}

model Scan {
  id         String   @id @default(cuid())
  attendeeId String
  stationId  String
  staffId    String?
  createdAt  DateTime @default(now())

  attendee   Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([attendeeId, stationId])
  @@index([createdAt])
  @@index([stationId])
}

/// Codigo de 6 digitos que se envia por correo antes de crear un pase
/// (REGISTER) o de abrir la cuenta de quien ya se registro (LOGIN).
/// Solo se guarda el HMAC del codigo, nunca el codigo en claro.
model EmailVerification {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose @default(REGISTER)
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}
